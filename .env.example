# Gemini API key — required. Get one at https://aistudio.google.com/app/apikey
# Used server-side only (in Next.js API routes). Never exposed to the browser.
GEMINI_API_KEY=your_api_key_here

# Optional: override the Gemini model used for all calls.
# Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash
