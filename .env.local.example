# Vercel KV — get these from Vercel Dashboard > Storage > KV
# After creating a KV store, click "Connect Project" then the
# ".env.local" tab to copy the values.
# These are auto-injected by Vercel in deployed environments; for local dev,
# copy the real values from the dashboard into .env.local manually.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
